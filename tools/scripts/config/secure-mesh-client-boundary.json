{
  "schemaVersion": "licomesh.secure-mesh.client-boundary-config.v1",
  "rules": [
    {
      "id": "flutter-gui-no-secure-mesh-backend-implementation",
      "description": "Application, UI, and reusable contract code must not implement Secure Mesh crypto, platform authentication, key storage, or proof internals.",
      "roots": [
        "apps/desktop/lib/src/application",
        "apps/desktop/lib/src/frontend",
        "apps/desktop/lib/src/contracts"
      ],
      "includeExtensions": [
        ".dart"
      ],
      "forbiddenTokens": [
        "package:crypto/crypto.dart",
        "package:cryptography/",
        "dart:ffi",
        "MethodChannel",
        "FlutterMethodChannel",
        "SecureMeshAndroidBridge",
        "SecureMeshIosBridge",
        "X25519",
        "HKDF",
        "ChaCha20Poly1305",
        "AES-GCM",
        "SecureMeshContentContext",
        "SecureMeshPairwise",
        "SecureMeshPairwiseSession",
        "SecureMeshPairwiseDurableStore",
        "seal_payload_envelope",
        "open_payload_envelope",
        "privateKeyBase64url",
        "signingKeyBase64url",
        "signedPrekeyPrivateKeyBase64url",
        "oneTimePrekeyPrivateKeyBase64url",
        "pairingSecretBase64url",
        "privateKeyMaterial",
        "signingKeyMaterial",
        "signedPrekeyPrivateKeyMaterial",
        "oneTimePrekeyPrivateKeyMaterial",
        "pairingSecretMaterial",
        "secretOverrides",
        "secretOverrideTransport",
        "AndroidKeyStore",
        "createConfirmDeviceCredentialIntent",
        "setUserAuthenticationRequired(",
        "AUTH_DEVICE_CREDENTIAL",
        "AUTH_BIOMETRIC_STRONG",
        "LAContext",
        "SecItemAdd",
        "SecAccessControlCreateWithFlags",
        "Keychain"
      ],
      "allowedMatches": [
        {
          "file": "apps/desktop/lib/src/platform/mobile_relay/mobile_relay_secure_mesh_service.dart",
          "tokens": [
            "SecureMeshIosBridge"
          ],
          "reason": "Mobile Relay service selects the platform bridge adapter while Secure Mesh protocol and platform-auth internals remain outside Flutter feature code."
        },
        {
          "file": "apps/desktop/lib/src/platform/mobile_relay/mobile_relay_service_ops.dart",
          "tokens": [
            "SecureMeshAndroidBridge"
          ],
          "reason": "Mobile Relay service operations route to the Android platform bridge adapter without implementing Secure Mesh crypto or secret-store internals."
        },
      {
        "file": "apps/desktop/lib/src/contracts/generated/secure_mesh.g.dart",
        "tokens": [
          "privateKeyMaterial"
        ],
        "reason": "Generated KT and MLS response parsing contains only negative leak-rejection guards; it rejects non-redacted private key material and never consumes it."
        }
      ]
    },
    {
      "id": "dart-services-are-bridges-not-protocol-implementations",
      "description": "Dart services may adapt CLI and platform bridge calls, but Secure Mesh algorithms and platform auth implementations stay outside Flutter service code.",
      "roots": [
        "apps/desktop/lib/src/backend",
        "apps/desktop/lib/src/contracts"
      ],
      "includeExtensions": [
        ".dart"
      ],
      "forbiddenTokens": [
        "package:crypto/crypto.dart",
        "package:cryptography/",
        "dart:ffi",
        "X25519",
        "HKDF",
        "ChaCha20Poly1305",
        "AES-GCM",
        "SecureMeshContentContext",
        "SecureMeshPairwise",
        "SecureMeshPairwiseSession",
        "SecureMeshPairwiseDurableStore",
        "seal_payload_envelope",
        "open_payload_envelope",
        "privateKeyBase64url",
        "signingKeyBase64url",
        "signedPrekeyPrivateKeyBase64url",
        "oneTimePrekeyPrivateKeyBase64url",
        "pairingSecretBase64url",
        "privateKeyMaterial",
        "signingKeyMaterial",
        "signedPrekeyPrivateKeyMaterial",
        "oneTimePrekeyPrivateKeyMaterial",
        "pairingSecretMaterial",
        "AndroidKeyStore",
        "createConfirmDeviceCredentialIntent",
        "setUserAuthenticationRequired(",
        "AUTH_DEVICE_CREDENTIAL",
        "AUTH_BIOMETRIC_STRONG",
        "LAContext",
        "SecItemAdd",
        "SecAccessControlCreateWithFlags",
        "Keychain"
      ],
      "allowedMatches": [
        {
          "file": "apps/desktop/lib/src/platform/storage/portable_data_root.dart",
          "tokens": [
            "package:crypto/crypto.dart"
          ],
          "reason": "Portable workspace manifest hashing is a non-secret identifier digest, not Secure Mesh protocol crypto."
        },
      {
        "file": "apps/desktop/lib/src/contracts/generated/secure_mesh.g.dart",
        "tokens": [
          "privateKeyMaterial"
        ],
        "reason": "Generated KT and MLS response parsing contains only negative leak-rejection guards; it rejects non-redacted private key material and never consumes it."
        }
      ]
    },
    {
      "id": "dart-method-channel-confined-to-platform-bridge",
      "description": "Flutter MethodChannel access for Secure Mesh stays in the explicit mobile bridge adapter.",
      "roots": [
        "apps/desktop/lib/src/application",
        "apps/desktop/lib/src/frontend",
        "apps/desktop/lib/src/backend",
        "apps/desktop/lib/src/contracts"
      ],
      "includeExtensions": [
        ".dart"
      ],
      "forbiddenTokens": [
        "MethodChannel"
      ],
      "allowedMatches": []
    },
    {
      "id": "rust-native-core-has-no-flutter-ui-dependency",
      "description": "Rust native code owns Secure Mesh backend decisions and must not depend on Flutter or GUI toolkit concepts.",
      "roots": [
        "crates/licoup-native/src"
      ],
      "includeExtensions": [
        ".rs"
      ],
      "forbiddenTokens": [
        "FlutterMethodChannel",
        "MethodChannel",
        "BuildContext",
        "MaterialApp",
        "Cupertino",
        "SwiftUI",
        "NSAlert",
        "AppKit",
        "flutter/services.dart",
        "package:flutter",
        "dart:ui"
      ],
      "allowedMatches": []
    },
    {
      "id": "android-activity-does-not-own-payload-crypto",
      "description": "Android platform code may orchestrate physical proof collection, AndroidKeyStore wrapping, and JNI calls, but Secure Mesh payload crypto must stay in the shared Rust core.",
      "roots": [
        "apps/desktop/android/app/src/main/kotlin/land/lico/licoup"
      ],
      "includeExtensions": [
        ".kt"
      ],
      "forbiddenTokens": [
        "ChaCha20-Poly1305",
        "HmacSHA256",
        "SecretKeySpec(derivedKey",
        "IvParameterSpec(header.nonce",
        "IvParameterSpec(nonce",
        "hkdfSaltDomain",
        "hkdfInfoDomain",
        "contentCipherSuite"
      ]
    },
    {
      "id": "android-platform-auth-does-not-collect-lock-screen-password",
      "description": "Android platform code must invoke the system credential prompt and must never collect lock-screen credentials in app-owned UI or payloads.",
      "roots": [
        "apps/desktop/android/app/src/main/kotlin/land/lico/licoup"
      ],
      "includeExtensions": [
        ".kt"
      ],
      "forbiddenTokens": [
        "lockScreenPassword",
        "screenLockPassword",
        "screenPassword",
        "devicePassword",
        "deviceCredentialPassword",
        "devicePasswordInput",
        "userEnteredPassword",
        "appLockPassword",
        "EditText",
        "TextInputEditText",
        "TextField",
        "OutlinedTextField",
        "BasicTextField",
        "PasswordVisualTransformation",
        "KeyboardType.Password",
        "PasswordTransformationMethod",
        "TYPE_TEXT_VARIATION_PASSWORD",
        "TYPE_NUMBER_VARIATION_PASSWORD",
        "numberPassword",
        "textPassword",
        "lockScreenPin",
        "devicePin",
        "pinCode",
        "android.text.InputType",
        "setInputType",
        "inputType",
        ".put(\"appCredentialPromptUsed\", true)",
        ".put(\"appPasswordPromptUsed\", true)",
        ".put(\"appLockScreenCredentialCollection\", true)",
        "\"appCredentialPromptUsed\" to true",
        "\"appPasswordPromptUsed\" to true",
        "\"appLockScreenCredentialCollection\" to true",
        "appCredentialPromptUsed = true",
        "appPasswordPromptUsed = true",
        "appLockScreenCredentialCollection = true"
      ],
      "allowedMatches": []
    },
    {
      "id": "android-mobile-relay-bridge-does-not-send-raw-e2ee-json",
      "description": "Android may expose opaque Mobile Relay secret-store handle metadata, but it must not send endpoint private keys, pairing secrets, or relay tokens through secretOverrides JSON.",
      "roots": [
        "apps/desktop/android/app/src/main/kotlin/land/lico/licoup"
      ],
      "includeExtensions": [
        ".kt"
      ],
      "forbiddenTokens": [
        "overrides.put(\"mobileRelayE2ee\"",
        "overrides.put(\"e2ee\"",
        "overrides.put(\"pcToken\"",
        "overrides.put(\"mobileToken\"",
        "overrides.put(\"pairedDevices\""
      ],
      "allowedMatches": []
    },
    {
      "id": "ios-mobile-relay-bridge-does-not-send-raw-e2ee-json",
      "description": "iOS may expose opaque Mobile Relay secret-store handle metadata, but it must not send endpoint private keys, pairing secrets, or relay tokens through secretOverrides JSON.",
      "roots": [
        "apps/desktop/ios/Runner"
      ],
      "includeExtensions": [
        ".swift"
      ],
      "forbiddenTokens": [
        "overrides[\"mobileRelayE2ee\"]",
        "overrides[\"e2ee\"]",
        "overrides[\"pcToken\"]",
        "overrides[\"mobileToken\"]",
        "overrides[\"pairedDevices\"]"
      ],
      "allowedMatches": []
    }
  ],
