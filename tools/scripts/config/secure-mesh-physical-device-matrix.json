  "physicalMatrix": [
    {
      "scenario": "pairing-and-trust",
      "requiredPlatforms": [
        "android",
        "iphone",
        "macos",
        "windows",
        "ubuntu-linux"
      ],
      "status": "missing",
      "requiredAssertions": [
        "QR, SAS, or fingerprint verification succeeds on physical devices.",
        "Unverified peers fail closed for sensitive sends.",
        "Key-change warning blocks sensitive operations.",
        "Revoked endpoints cannot use command, result, file, prekey, or group payloads."
      ]
    },
    {
      "scenario": "command-result",
      "requiredPlatforms": [
        "android-to-desktop",
        "desktop-to-android",
        "iphone-to-desktop",
        "desktop-to-iphone"
      ],
      "status": "missing",
      "requiredAssertions": [
        "Durable pairwise envelopes or MLS exporter keys are used.",
        "Wrong recipient, replay, stale envelope, and restart cases pass.",
        "The station remains non-authoritative while endpoints authenticate the exchange."
      ]
    },
    {
      "scenario": "file-handoff",
      "requiredPlatforms": [
        "android-to-desktop-to-iphone",
        "iphone-to-desktop-to-android"
      ],
      "status": "missing",
      "requiredAssertions": [
        "Manifest and chunks remain encrypted.",
        "Second phone receives endpoint-specific resealed ciphertext.",
        "Approved receive root is required.",
        "Client cryptography keeps file metadata and content out of the relay envelope surface."
      ]
    },
    {
      "scenario": "licoarc-badtower-interoperability",
      "requiredPlatforms": [
        "fresh-licoup-endpoints",
        "badtower-station"
      ],
      "status": "missing",
      "requiredAssertions": [
        "Two fresh endpoints complete a positive encrypted round trip.",
        "The station stores no endpoint plaintext and transport hints remain non-authoritative.",
        "Non-conformant envelopes are rejected and the Lico Arc outer envelope has exactly five fields."
      ]
    },
    {
      "scenario": "desktop-release-platforms",
      "requiredPlatforms": [
        "macos",
        "windows",
        "ubuntu-linux"
      ],
      "status": "missing",
      "requiredAssertions": [
        "Release-built clients pass trust, command/result, and file handoff checks.",
        "Signed update, downgrade rejection, rollback, installer or package proof, and publication receipt are linked from the release proof bundle."
      ]
    }
  ]
}
