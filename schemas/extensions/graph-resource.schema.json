{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://licoland.com/schemas/extensions/graph-resource.schema.json",
  "title": "LicoUp versioned prepared graph resource",
  "description": "One bounded pure-data document behind the `licoup.ui.graph-resource.v1` resource-view capability. It carries stable project/lane/node/gate identities, typed edges, plan/run revision, source position, execution/acceptance/observation dimensions, ready/startable reasons and opaque actions/results/evidence. It is data: there is no script, widget tree, RPC handle, secret, or raw source text, and the renderer never reads a runtime, store or controller. One shared gate keeps one semantic identity, count and run across every reference anchor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "projects", "edges"],
  "properties": {
    "schema": {
      "const": "licoup.ui.graph-resource.v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Plan/run revision this document was projected from. A higher revision supersedes a lower one of the same source epoch; a replaced source opens a new epoch."
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "The complete multi-project projection. Collapsing or filtering a project in the interface never removes it from this document and never changes its total goal counts.",
      "items": { "$ref": "#/$defs/project" }
    },
    "edges": {
      "type": "array",
      "maxItems": 2000,
      "description": "Typed relationships between nodes of any project, so a cross-project shared input stays one edge and one semantic identity.",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "stableId": {
      "$ref": "#/$defs/namespacedName"
    },
    "namespacedName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+(?:[./-][A-Za-z0-9_-]+)*$",
      "maxLength": 160,
      "description": "Namespaced stable identity, the same rule the extension schemas publish."
    },
    "opaqueRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$",
      "description": "Opaque action, result or evidence reference. The interface displays and sends it back; it never interprets it."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "lanes", "nodes", "gates"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "$ref": "#/$defs/title" },
        "role": { "$ref": "#/$defs/namespacedName" },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/lane" }
        },
        "nodes": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/node" }
        },
        "gates": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/gate" }
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "$ref": "#/$defs/title" },
        "order": { "type": "integer", "minimum": 0 },
        "role": { "$ref": "#/$defs/namespacedName" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "role", "execution", "acceptance", "observation", "ready", "startable"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "$ref": "#/$defs/title" },
        "laneId": { "$ref": "#/$defs/stableId" },
        "gateId": {
          "$ref": "#/$defs/stableId",
          "description": "The one shared gate this node is a reference anchor of. A gate with several anchors keeps one semantic identity, one count and one run."
        },
        "role": { "$ref": "#/$defs/namespacedName" },
        "route": { "$ref": "#/$defs/namespacedName" },
        "execution": {
          "enum": ["not-started", "claimed", "running", "succeeded", "failed", "cancelled"],
          "description": "Projected command execution, separate from work acceptance and observation freshness."
        },
        "acceptance": { "enum": ["pending", "reviewing", "accepted", "rejected", "superseded"] },
        "observation": {
          "enum": ["fresh", "stale", "unknown"],
          "description": "Freshness of the last observation. `stale` is never evidence that execution failed."
        },
        "ready": { "type": "boolean" },
        "startable": { "type": "boolean" },
        "blockers": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/blocker" }
        },
        "consumes": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/resultRef" },
          "description": "Typed input results this node requires. The interface derives real consumers from these declarations, never from a guess."
        },
        "results": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/resultRef" }
        },
        "actions": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/opaqueRef" },
          "description": "Opaque action references the host may dispatch for this node. The host owns their authority; the document only names them."
        },
        "attempts": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/attempt" }
        },
        "visits": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/visit" }
        },
        "events": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/event" }
        },
        "evidence": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "dependency_missing",
            "result_missing",
            "visit_missing",
            "not_materialized",
            "authority_missing",
            "route_unavailable",
            "budget_missing",
            "capacity_missing",
            "conflicting_writer",
            "observation_stale",
            "managed_by_other",
            "paused",
            "unknown"
          ],
          "description": "Why the node is not ready or not startable, as the native owner reported it. The interface renders this reason; it never decides readiness itself."
        },
        "detail": { "$ref": "#/$defs/detail" },
        "affects": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/stableId" },
          "description": "Nodes this blocker really affects, when the producer can name them. Only these are highlighted."
        }
      }
    },
    "resultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "kind"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["candidate", "accepted"] },
        "ref": { "$ref": "#/$defs/opaqueRef" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueRef" },
        "role": { "$ref": "#/$defs/namespacedName" },
        "route": { "$ref": "#/$defs/namespacedName" },
        "state": {
          "enum": ["queued", "running", "succeeded", "failed", "cancelled", "superseded"]
        },
        "errorCode": { "$ref": "#/$defs/namespacedName" },
        "errorDetail": { "$ref": "#/$defs/detail" }
      }
    },
    "visit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueRef" },
        "kind": { "enum": ["visit", "join"] },
        "at": {
          "type": "string",
          "maxLength": 40,
          "description": "Producer-issued timestamp or ordering label. The interface displays it; it is not a scheduling clock."
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "at": { "type": "string", "maxLength": 40 },
        "kind": { "$ref": "#/$defs/namespacedName" },
        "detail": { "$ref": "#/$defs/detail" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind"],
      "properties": {
        "ref": { "$ref": "#/$defs/opaqueRef" },
        "kind": { "$ref": "#/$defs/namespacedName" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "anchors", "runCount"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "$ref": "#/$defs/title" },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/stableId" },
          "description": "Node references of one shared gate. Multiple anchors are one semantic gate: they share one identity, one count and one run."
        },
        "runCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Runs of the gate itself. Anchors never add to it."
        },
        "role": { "$ref": "#/$defs/namespacedName" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "from": { "$ref": "#/$defs/stableId" },
        "to": { "$ref": "#/$defs/stableId" },
        "kind": {
          "enum": ["requires", "visit", "successor", "result"],
          "description": "Typed relationship. `visit` covers a legal cycle the producer declared; an undeclared dependency cycle is a producer error, not a layout decision."
        }
      }
    }
  }
}
