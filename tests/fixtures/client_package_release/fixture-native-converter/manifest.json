    "targetFormat": "licoup.conversation.v1"
  },
  "activation": "on-demand",
  "requires": [],
  "optionalRequires": [],
  "permissions": [
    {
      "capability": "org.licoland.fixture/files",
      "scope": "self"
    }
  ],
  "contributions": []
}
