{
  "schema": "licoup.extension-package.v1",
  "id": "org.licoland.fixture.native-converter",
  "version": "1.3.0",
  "displayName": "LicoUp fixture native converter",
  "hostProtocol": {
    "major": 1,
    "minimumMinor": 0
  },
  "compatibility": {
    "clientVersions": [
      ">=0.2.0, <1.0.0"
    ]
  },
  "profiles": [
    {
      "id": "native-converter-fixture",
      "major": 1
    }
  ],
  "runtime": {
