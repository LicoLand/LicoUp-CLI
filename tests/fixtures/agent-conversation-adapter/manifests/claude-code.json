{
  "schemaVersion": "lico.agent-conversation-adapter.v1",
  "identity": {
    "agentId": "claude-code",
    "driverId": "claude-code-stream-json",
    "runtimeProtocol": "claude-code-cli-stream-json",
    "packagingTargetId": "claude-code"
  },
  "officialCapabilityAssessment": {
    "completedBeforeImplementation": true,
    "sourceAuthority": "official",
    "versionSupport": {
      "kind": "unknown",
      "source": "unverified",
      "reason": "no_verified_vendor_bound"
    },
    "interfaceName": "official streaming input and stream-json output",
    "assessedVersion": "version reported by fixed Claude Code probe",
    "versionProbe": "fixed --version probe",
    "capabilityProbe": "fixed help probe for streaming input flags",
    "newSessionMethod": "first supervised streaming-input turn",
    "exactResumeMethod": "process-local binding with native --resume fallback",
    "streamingMethod": "stream-json partial message events",
    "historyMethod": "process-local exact transcript projection",
    "cleanupMethod": "terminate supervised process and erase process-local binding",
    "officialReferences": [
      "https://docs.anthropic.com/en/docs/claude-code/cli-reference"
    ]
  },
  "transport": {
    "family": "stream-json",
    "origin": "official",
    "promptChannel": "stdin",
    "continuityChannel": "launch-argument",
    "workingDirectoryChannel": "process-cwd",
    "framing": "jsonl",
    "sessionScope": "persistent",
    "fixedLaunchArguments": [
      "--print",
      "--input-format",
      "stream-json",
      "--output-format",
      "stream-json",
      "--include-partial-messages"
    ]
  },
  "configuration": {
    "binaryEnvironmentKeys": [
      "CLAUDE_PATH",
      "CLAUDE_BIN"
    ],
    "authentication": "runtime-owned",
    "modelSelection": "request-field",
    "reasoningSelection": "request-field",
    "permissionSelection": "runtime-owned"
  },
  "operations": {
    "discover": {
      "status": "supported",
      "method": "fixed version and capability probes"
    },
    "openNew": {
      "status": "supported",
      "method": "first supervised streaming-input turn"
    },
    "exactResume": {
      "status": "supported",
      "method": "process-local binding with native --resume fallback"
    },
    "send": {
      "status": "supported",
      "method": "official structured prompt operation"
    },
    "stream": {
      "status": "supported",
      "method": "stream-json partial message events"
    },
    "cancel": {
      "status": "supported",
      "method": "cancel active supervised turn"
    },
    "interruptSteer": {
      "status": "supported",
      "method": "stream-json user message on the bound active input transport"
    },
    "cleanup": {
      "status": "supported",
      "method": "terminate supervised process and erase process-local binding"
    },
    "history": {
      "status": "supported",
      "method": "process-local exact transcript projection"
    },
    "approvals": {
      "status": "unsupported",
      "method": "client approval response bridge is not enabled"
    },
    "usage": {
      "status": "unsupported",
      "method": "official lane usage projection is not enabled"
    },
    "multimodal": {
      "status": "unsupported",
      "method": "current adapter contribution is text-only"
    }
  },
  "events": {
    "framing": "jsonl",
    "realtimeKinds": [
      "agent.message.chunk",
      "agent.tool.started",
      "agent.tool.completed"
    ],
    "terminalKinds": [
      "dispatch.turn.completed",
      "dispatch.turn.failed"
    ],
    "sessionOwned": true,
    "turnOwned": true
  },
  "lifecycle": {
    "supervision": "process-tree",
    "cleanupScope": "process-session",
    "cancelHandleScope": "active-turn",
    "maxConcurrentTransports": 8,
    "maxTrackedSessions": 1024,
    "survivesGuiDisconnect": true,
    "reattachScope": "activeTurn",
    "replayMode": "orderedCursor"
  },
  "privacy": {
    "promptInArguments": false,
    "continuityIdInArguments": true,
    "boundedInput": true,
    "boundedOutput": true,
    "structuredEventProjection": true,
    "safeCleanup": true,
    "redactedEvidence": true
  },
  "routedContext": {
    "contractVersion": "lico.routing.distillation-package.v1",
    "deliveryChannel": "prompt-envelope",
    "maxPackageBytes": 65536,
    "requiredSections": [
      "objective",
      "currentState",
      "decisions",
      "constraints",
      "openItems"
    ],
    "sourceReferences": "opaque-digest-only",
    "rawConversationAllowed": false,
    "contextDigestRequired": true,
    "fidelityFailure": "fail-closed",
    "finalReplyFeedsNextDistillation": true
  },
  "productIntegration": {
    "dispatchLane": "AgentDispatchLane",
    "cliUsesCanonicalReadiness": true,
    "guiUsesCanonicalReadiness": true,
    "routingUsesCanonicalReadiness": true,
    "sharedNativeHistoryAuthority": true,
    "finalReplyFeedsThreadAndDistillation": true
  },
  "acceptance": {
    "coreChecks": [
      "P-01",
      "P-02",
      "P-03",
      "P-04",
      "P-05",
      "P-06",
      "P-07",
      "P-08",
      "P-09",
      "P-10"
    ],
    "conditionalChecks": [
      "C-01",
      "C-02",
      "C-03",
      "C-04",
      "C-05",
      "C-06"
    ],
    "checkSemantics": {
      "P-01": "baseline-binding",
      "P-02": "native-session-creation",
      "P-03": "bidirectional-exact-resume",
      "P-04": "deterministic-final-result",
      "P-05": "effective-settings-parity",
      "P-06": "history-readback-and-rendering",
      "P-07": "error-cancel-timeout-parity",
      "P-08": "privacy-and-process-boundary",
      "P-09": "isolation-and-cleanup",
      "P-10": "exact-release-product-ui",
      "C-01": "streaming-delta",
      "C-02": "reasoning-and-tool-trace",
      "C-03": "approval-lifecycle",
      "C-04": "attachments-and-multimodal",
      "C-05": "interrupt-and-steer",
      "C-06": "usage-and-status"
    },
    "minimumConsecutivePasses": 1,
    "minimumConsecutiveReleaseUiPasses": 1,
    "productUiRequired": true,
    "releaseP10Required": true,
    "liveLocalForwardingRequired": true,
    "realtimeOutputRequired": true,
    "sameNativeSessionRequired": true,
    "continuityScope": "process-local",
    "canonicalReadinessRequired": true,
    "nativeToArcRequired": false,
    "arcToNativeRequired": false,
    "exactArtifactRequired": true
  }
}
