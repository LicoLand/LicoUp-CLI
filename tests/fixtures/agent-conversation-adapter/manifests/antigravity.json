{
  "schemaVersion": "lico.agent-conversation-adapter.v1",
  "identity": {
    "agentId": "antigravity",
    "driverId": "antigravity-cli",
    "runtimeProtocol": "antigravity-cli-argv-hook-v1",
    "packagingTargetId": "antigravity"
  },
  "officialCapabilityAssessment": {
    "completedBeforeImplementation": true,
    "sourceAuthority": "official",
    "versionSupport": {
      "kind": "unknown",
      "source": "unverified",
      "reason": "no_verified_vendor_bound"
    },
    "interfaceName": "official Antigravity CLI argv lane with Agent Hooks session receipt",
    "assessedVersion": "version reported by fixed Antigravity CLI probe",
    "versionProbe": "fixed --version probe",
    "capabilityProbe": "fixed help probe for --print, --conversation, --model, and --effort",
    "newSessionMethod": "agy --print=<prompt> plus Stop/PreInvocation hook conversationId receipt",
    "exactResumeMethod": "--conversation=<id> with caller-supplied native id in launch arguments",
    "streamingMethod": "PTY transport projects progressive structured lifecycle and output events",
    "historyMethod": "read-only native history is outside the send lane",
    "cleanupMethod": "delete local antigravity-cli brain leaf for the exact conversation id",
    "officialReferences": [
      "https://antigravity.google/docs/hooks",
      "https://antigravity.google/docs/cli/plugins"
    ]
  },
  "transport": {
    "family": "cli",
    "origin": "official",
    "promptChannel": "launch-argument",
    "continuityChannel": "launch-argument",
    "workingDirectoryChannel": "process-cwd",
    "framing": "text",
    "sessionScope": "persistent",
    "fixedLaunchArguments": [
      "--print",
      "--dangerously-skip-permissions"
    ]
  },
  "configuration": {
    "binaryEnvironmentKeys": [
      "ANTIGRAVITY_PATH",
      "AGY_PATH"
    ],
    "authentication": "runtime-owned",
    "modelSelection": "request-field",
    "reasoningSelection": "request-field",
    "permissionSelection": "runtime-owned"
  },
  "operations": {
    "discover": {
      "status": "supported",
      "method": "fixed version and capability probes"
    },
    "openNew": {
      "status": "supported",
      "method": "agy --print plus official Agent Hooks conversationId receipt"
    },
    "exactResume": {
      "status": "supported",
      "method": "--conversation with caller-supplied native id in launch arguments"
    },
    "send": {
      "status": "supported",
      "method": "official supervised --print turn"
    },
    "stream": {
      "status": "supported",
      "method": "PTY transport projects progressive structured lifecycle and output events"
    },
    "cancel": {
      "status": "supported",
      "method": "cancel active supervised turn"
    },
    "interruptSteer": {
      "status": "unsupported",
      "method": "combined in-flight interrupt and steer is not enabled"
    },
    "cleanup": {
      "status": "supported",
      "method": "delete local antigravity-cli brain leaf for the exact conversation id"
    },
    "history": {
      "status": "supported",
      "method": "read-only native history is outside the send lane"
    },
    "approvals": {
      "status": "unsupported",
      "method": "client approval response bridge is not enabled"
    },
    "usage": {
      "status": "unsupported",
      "method": "official lane usage projection is not enabled"
    },
    "multimodal": {
      "status": "unsupported",
      "method": "current adapter contribution is text-only"
    }
  },
  "events": {
    "framing": "text",
    "realtimeKinds": [
      "agent.turn.accepted",
      "agent.turn.responding",
      "agent.message.chunk"
    ],
    "terminalKinds": [
      "agent.message.completed",
      "dispatch.turn.completed",
      "dispatch.turn.failed"
    ],
    "sessionOwned": true,
    "turnOwned": true
  },
  "lifecycle": {
    "supervision": "process-tree",
    "cleanupScope": "official-session",
    "cancelHandleScope": "active-turn",
    "maxConcurrentTransports": 8,
    "maxTrackedSessions": 1024,
    "survivesGuiDisconnect": true,
    "reattachScope": "activeTurn",
    "replayMode": "orderedCursor"
  },
  "privacy": {
    "promptInArguments": true,
    "continuityIdInArguments": true,
    "boundedInput": true,
    "boundedOutput": true,
    "structuredEventProjection": true,
    "safeCleanup": true,
    "redactedEvidence": true
  },
  "routedContext": {
    "contractVersion": "lico.routing.distillation-package.v1",
    "deliveryChannel": "prompt-envelope",
    "maxPackageBytes": 65536,
    "requiredSections": [
      "objective",
      "currentState",
      "decisions",
      "constraints",
      "openItems"
    ],
    "sourceReferences": "opaque-digest-only",
    "rawConversationAllowed": false,
    "contextDigestRequired": true,
    "fidelityFailure": "fail-closed",
    "finalReplyFeedsNextDistillation": true
  },
  "productIntegration": {
    "dispatchLane": "AgentDispatchLane",
    "cliUsesCanonicalReadiness": true,
    "guiUsesCanonicalReadiness": true,
    "routingUsesCanonicalReadiness": true,
    "sharedNativeHistoryAuthority": true,
    "finalReplyFeedsThreadAndDistillation": true
  },
  "acceptance": {
    "coreChecks": [
      "P-01",
      "P-02",
      "P-03",
      "P-04",
      "P-05",
      "P-06",
      "P-07",
      "P-08",
      "P-09",
      "P-10"
    ],
    "conditionalChecks": [
      "C-01",
      "C-02",
      "C-03",
      "C-04",
      "C-05",
      "C-06"
    ],
    "checkSemantics": {
      "P-01": "baseline-binding",
      "P-02": "native-session-creation",
      "P-03": "same-session-sequential-resume",
      "P-04": "deterministic-final-result",
      "P-05": "effective-settings-parity",
      "P-06": "history-readback-and-rendering",
      "P-07": "error-cancel-timeout-parity",
      "P-08": "privacy-and-process-boundary",
      "P-09": "isolation-and-cleanup",
      "P-10": "same-session-sequential-turns",
      "C-01": "streaming-delta",
      "C-02": "reasoning-and-tool-trace",
      "C-03": "approval-lifecycle",
      "C-04": "attachments-and-multimodal",
      "C-05": "interrupt-and-steer",
      "C-06": "usage-and-status"
    },
    "minimumConsecutivePasses": 1,
    "minimumConsecutiveReleaseUiPasses": 0,
    "productUiRequired": false,
    "releaseP10Required": false,
    "liveLocalForwardingRequired": true,
    "realtimeOutputRequired": false,
    "sameNativeSessionRequired": true,
    "canonicalReadinessRequired": true,
    "nativeToArcRequired": false,
    "arcToNativeRequired": false,
    "exactArtifactRequired": false
  }
}
