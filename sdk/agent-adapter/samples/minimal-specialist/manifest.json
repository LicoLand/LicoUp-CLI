{
  "schema": "licoup.extension-package.v1",
  "id": "dev.example.agent.sdk-minimal",
  "version": "1.0.0",
  "displayName": "SDK sample: minimal specialist",
  "hostProtocol": {
    "major": 1,
    "minimumMinor": 0
  },
  "profiles": [
    {
      "id": "agent-execution",
      "major": 1,
      "capabilities": [
        "dev.example.agent/stream"
      ]
    }
  ],
  "runtime": {
    "mode": "process",
    "entry": "agent.py",
    "runtimeRef": "user:python3"
  },
  "activation": "on-demand",
  "requires": [
    {
      "packageId": "org.licoland.core",
      "range": "^0.3"
    }
  ],
  "optionalRequires": [],
  "permissions": [],
  "contributions": [],
  "extensions": {
    "dev.example.agent/purpose": "SDK sample: the smallest complete Agent implements the handshake plus agent.describe, agent.execute and agent.event, and declares every optional ability unsupported."
  }
}
